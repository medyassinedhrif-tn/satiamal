generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SELLER
  ADMIN
}

enum ListingStatus {
  ACTIVE
  HIDDEN
}

enum Cycle {
  primaire
  college
  lycee
}

enum MaterialType {
  joudhadha
  devoir
  serie
  cours
}

enum TopupType {
  CODE_PACK
  BOOST
}

enum PaymentMethod {
  D17
  FLOUCI
  RIB
}

enum TopupStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportReason {
  PIRACY
  SCAM
  WRONG_INFO
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String         @unique @db.VarChar(120)
  passwordHash  String         @map("password_hash")
  role          UserRole       @default(SELLER)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  sellerProfile SellerProfile?
  refreshTokens RefreshToken[]
  listings      Listing[]
  downloadCodes DownloadCode[]
  topups        CodeTopup[]
  reviewedTopups CodeTopup[]   @relation("TopupReviewer")

  @@map("users")
}

model SellerProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  slug        String   @unique @db.VarChar(60)
  displayName String   @map("display_name") @db.VarChar(100)
  whatsapp    String   @db.VarChar(20)
  messengerUrl String? @map("messenger_url")
  bio         String?  @db.VarChar(300)
  isVerified  Boolean  @default(false) @map("is_verified")
  codeBalance Int      @default(5) @map("code_balance")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Listing {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String        @map("seller_id") @db.Uuid
  title          String        @db.VarChar(160)
  description    String
  cycle          Cycle
  grade          String        @db.VarChar(40)
  subject        String        @db.VarChar(60)
  trimester      Int?          @db.SmallInt
  materialType   MaterialType  @map("material_type")
  priceTnd       Decimal       @map("price_tnd") @db.Decimal(7, 2)
  previewImages  String[]      @map("preview_images")
  r2PdfKey       String        @map("r2_pdf_key")
  isBoosted      Boolean       @default(false) @map("is_boosted")
  boostExpiresAt DateTime?     @map("boost_expires_at") @db.Timestamptz
  status         ListingStatus @default(ACTIVE)
  contactClicks  Int           @default(0) @map("contact_clicks")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  seller         User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  codes          DownloadCode[]
  topups         CodeTopup[]
  reports        ListingReport[]

  @@index([status, isBoosted(sort: Desc), cycle, grade, subject, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@map("listings")
}

model DownloadCode {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String        @unique @db.VarChar(12)
  listingId    String        @map("listing_id") @db.Uuid
  sellerId     String        @map("seller_id") @db.Uuid
  buyerPhone   String        @map("buyer_phone") @db.VarChar(20)
  buyerNote    String?       @map("buyer_note") @db.VarChar(100)
  hmacSig      String        @map("hmac_sig") @db.VarChar(32)
  downloadCount Int          @default(0) @map("download_count")
  maxDownloads Int           @default(3) @map("max_downloads")
  firstUsedAt  DateTime?     @map("first_used_at") @db.Timestamptz
  expiresAt    DateTime?     @map("expires_at") @db.Timestamptz
  isRevoked    Boolean       @default(false) @map("is_revoked")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller       User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  logs         DownloadLog[]

  @@index([sellerId, buyerPhone])
  @@index([code])
  @@map("download_codes")
}

model DownloadLog {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeId       String       @map("code_id") @db.Uuid
  ipAddress    String       @map("ip_address") @db.Inet
  userAgent    String?      @map("user_agent")
  downloadedAt DateTime     @default(now()) @map("downloaded_at") @db.Timestamptz
  code         DownloadCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([codeId, downloadedAt(sort: Desc)])
  @@map("download_logs")
}

model CodeTopup {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String        @map("seller_id") @db.Uuid
  topupType     TopupType     @map("topup_type")
  packCodes     Int?           @map("pack_codes")
  listingId     String?        @map("listing_id") @db.Uuid
  boostDays     Int?           @map("boost_days")
  amountTnd     Decimal        @map("amount_tnd") @db.Decimal(7, 2)
  paymentMethod PaymentMethod  @map("payment_method")
  receiptRef    String         @map("receipt_ref")
  status        TopupStatus    @default(PENDING)
  reviewedBy    String?        @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?      @map("reviewed_at") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  listing       Listing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reviewer      User?          @relation("TopupReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("code_topups")
}

model ListingReport {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId  String       @map("listing_id") @db.Uuid
  reason     ReportReason
  details    String?      @db.VarChar(400)
  reporterIp String       @map("reporter_ip") @db.Inet
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_reports")
}
